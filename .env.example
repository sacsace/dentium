# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dentium_india?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
ADMIN_EMAIL="admin@dentium.in"
ADMIN_PASSWORD="admin123"

# App
NEXT_PUBLIC_APP_URL="https://www.dentium.in"
NEXT_PUBLIC_APP_NAME="Dentium"

# File storage (optional — Railway uses /tmp by default; mount a volume and set this path)
# STORAGE_PATH="/data/storage"

# CCAvenue Payment Gateway (https://www.ccavenue.com/)
# Obtain credentials from CCAvenue Merchant Dashboard → Settings → API Keys
CCAVENUE_MERCHANT_ID=""
CCAVENUE_ACCESS_CODE=""
CCAVENUE_WORKING_KEY=""
# test | production
CCAVENUE_ENV="test"
