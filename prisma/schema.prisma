generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  QUOTE_REQUESTED
  QUOTE_SENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PostType {
  BLOG
  NEWS
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  firstName     String?
  lastName      String?
  company       String?
  phone         String?
  gstin         String?
  dciNumber     String?
  panNumber     String?
  state         String?
  city          String?
  pincode       String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  quoteRequests QuoteRequest[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  posts       Post[]
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String    @db.Text
  shortDesc       String?
  sku             String?   @unique
  price           Decimal?  @db.Decimal(12, 2)
  showPrice       Boolean   @default(false)
  brand           String?
  tags            String[]
  images          String[]
  specifications  Json?
  downloads       Json?
  features        String[]
  isFeatured      Boolean   @default(false)
  isNew           Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
}

model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String     @db.Text
  featuredImage   String?
  type            PostType   @default(BLOG)
  status          PostStatus @default(PUBLISHED)
  isFeatured      Boolean    @default(false)
  isPopular       Boolean    @default(false)
  tags            String[]
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id])
  authorName      String?
  viewCount       Int        @default(0)
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Event {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String      @db.Text
  excerpt         String?
  featuredImage   String?
  location        String?
  venue           String?
  region          String?
  startDate       DateTime
  endDate         DateTime?
  status          EventStatus @default(UPCOMING)
  isFeatured      Boolean     @default(false)
  registrationUrl String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  image       String
  videoUrl    String?
  ctaText     String?
  ctaLink     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PopupBanner {
  id          String   @id @default(cuid())
  title       String
  content     String?  @db.Text
  image       String?
  ctaText     String?
  ctaLink     String?
  isActive    Boolean  @default(false)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlobalOffice {
  id          String   @id @default(cuid())
  country     String
  city        String
  address     String?
  phone       String?
  email       String?
  latitude    Float?
  longitude   Float?
  isHeadquarter Boolean @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InquiryStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

enum ResumeStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum ResumeAttachmentType {
  EMPLOYMENT_CERTIFICATE
  EMPLOYMENT_CONTRACT
  PAYSLIP
  GRADUATION_CERTIFICATE
  TRANSCRIPT
  OTHER
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Dentium India")
  tagline         String?
  logo            String?
  favicon         String?
  aboutTitle      String?
  aboutContent    String?  @db.Text
  aboutMission    String?  @db.Text
  aboutVision     String?  @db.Text
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?  @db.Text
  socialFacebook  String?
  socialTwitter   String?
  socialLinkedin  String?
  socialInstagram String?
  socialYoutube   String?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  heroVideoUrl    String?
  smtpHost        String?
  smtpPort        Int?     @default(587)
  smtpUser        String?
  smtpPass        String?
  smtpFromEmail   String?
  smtpFromName    String?
  smtpSecure      Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model ContactInquiry {
  id         String         @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  subject    String?
  message    String         @db.Text
  type       String         @default("general")
  status     InquiryStatus  @default(PENDING)
  adminReply String?        @db.Text
  repliedAt  DateTime?
  createdAt  DateTime       @default(now())
}

model ResumeApplication {
  id            String             @id @default(cuid())
  name          String
  email         String
  phone         String?
  positionCategory String?
  position      String?
  photoUrl      String?
  dateOfBirth   String?
  address       String?            @db.Text
  summary       String?            @db.Text
  education     Json               @default("[]")
  experience    Json               @default("[]")
  skills        String?            @db.Text
  languages     String?
  hasExperience Boolean            @default(false)
  status        ResumeStatus       @default(PENDING)
  adminNotes    String?            @db.Text
  sortOrder     Int                @default(0)
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attachments   ResumeAttachment[]
}

model ResumeAttachment {
  id            String               @id @default(cuid())
  applicationId String
  application   ResumeApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ResumeAttachmentType
  fileName      String
  fileUrl       String
  createdAt     DateTime             @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  guestEmail  String?
  guestName   String?
  guestPhone  String?
  guestCompany String?
  status      OrderStatus @default(PENDING)
  notes       String?     @db.Text
  totalAmount Decimal?    @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Decimal? @db.Decimal(12, 2)
}

model QuoteRequest {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  name        String
  email       String
  phone       String?
  company     String?
  message     String?     @db.Text
  status      OrderStatus @default(QUOTE_REQUESTED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       QuoteItem[]
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int          @default(1)
  notes          String?
}

model PageVisit {
  id         String   @id @default(cuid())
  path       String
  referrer   String?
  visitorKey String
  userAgent  String?
  device     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorKey])
  @@index([createdAt, visitorKey])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@index([subscribedAt])
}

model DownloadResource {
  id            String   @id @default(cuid())
  title         String
  description   String?
  fileUrl       String
  fileName      String
  fileType      String   @default("PDF")
  fileSizeBytes Int?
  requiresLogin Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  caption   String?
  imageUrl  String
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}

model CompanyHistory {
  id          String   @id @default(cuid())
  year        Int
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder, year])
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  department String?
  bio        String?  @db.Text
  photoUrl   String
  photoFocalX Float   @default(50)
  photoFocalY Float   @default(38)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}
