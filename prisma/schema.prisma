generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MembershipTier {
  ASSOCIATE
  FULL
}

enum FullMemberApplicationStatus {
  NONE
  PENDING
  REJECTED
}

enum OrderStatus {
  PENDING
  QUOTE_REQUESTED
  QUOTE_SENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PostType {
  BLOG
  NEWS
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ProductType {
  SIMPLE
  BUNDLE
}

enum PromotionType {
  BOGO
}

enum PopupContentType {
  IMAGE
  VIDEO
  HTML
}

enum PopupDisplayTarget {
  ALL
  MOBILE
  DESKTOP
}

enum CouponEmailSegment {
  ALL_USERS
  ACTIVE_USERS
  SPECIFIC_USERS
}

enum CouponEmailCampaignStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ReturnRequestType {
  RETURN
  EXCHANGE
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum LedgerRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  firstName     String?
  lastName      String?
  company       String?
  phone         String?
  erpCustomerNumber String?
  gstin         String?
  dciNumber     String?
  panNumber     String?
  state         String?
  city          String?
  pincode       String?
  role          UserRole  @default(USER)
  membershipTier MembershipTier @default(ASSOCIATE)
  licenseDocumentUrl String?
  fullMemberStatus FullMemberApplicationStatus @default(NONE)
  fullMemberRequestedAt DateTime?
  fullMemberReviewNote String?
  sessionVersion Int      @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders          Order[]
  quoteRequests   QuoteRequest[]
  productLikes    ProductLike[]
  returnRequests  ReturnRequest[]
  ledgerRequests  LedgerRequest[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  posts       Post[]
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String    @db.Text
  shortDesc       String?
  sku             String?   @unique
  price           Decimal?  @db.Decimal(12, 2)
  showPrice       Boolean   @default(false)
  brand           String?
  tags            String[]
  images          String[]
  specifications  Json?
  downloads       Json?
  features        String[]
  isFeatured      Boolean   @default(false)
  isNew           Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  productType     ProductType @default(SIMPLE)
  gstRate         Decimal   @default(18) @db.Decimal(5, 2)
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
  likes           ProductLike[]
  variants        ProductVariant[]
  bundleItems     ProductBundleItem[] @relation("BundleProduct")
  bundleComponents ProductBundleItem[] @relation("BundleComponent")
  promotionsAsBuy Promotion[] @relation("PromotionBuy")
  promotionsAsGet Promotion[] @relation("PromotionGet")
}

model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String     @db.Text
  featuredImage   String?
  type            PostType   @default(BLOG)
  status          PostStatus @default(PUBLISHED)
  isFeatured      Boolean    @default(false)
  isPopular       Boolean    @default(false)
  tags            String[]
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id])
  authorName      String?
  viewCount       Int        @default(0)
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Event {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String      @db.Text
  excerpt         String?
  featuredImage   String?
  location        String?
  venue           String?
  region          String?
  startDate       DateTime
  endDate         DateTime?
  status          EventStatus @default(UPCOMING)
  isFeatured      Boolean     @default(false)
  registrationUrl String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  image       String
  videoUrl    String?
  ctaText     String?
  ctaLink     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PopupBanner {
  id            String             @id @default(cuid())
  title         String
  content       String?            @db.Text
  image         String?
  videoUrl      String?
  contentType   PopupContentType   @default(IMAGE)
  displayTarget PopupDisplayTarget @default(ALL)
  ctaText       String?
  ctaLink       String?
  isActive      Boolean            @default(false)
  sortOrder     Int                @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model GlobalOffice {
  id          String   @id @default(cuid())
  country     String
  city        String
  address     String?
  phone       String?
  email       String?
  latitude    Float?
  longitude   Float?
  isHeadquarter Boolean @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InquiryStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

enum ResumeStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum ResumeAttachmentType {
  RESUME
  EMPLOYMENT_CERTIFICATE
  EMPLOYMENT_CONTRACT
  PAYSLIP
  GRADUATION_CERTIFICATE
  TRANSCRIPT
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Dentium India")
  tagline         String?
  logo            String?
  favicon         String?
  aboutTitle      String?
  aboutContent    String?  @db.Text
  aboutMission    String?  @db.Text
  aboutVision     String?  @db.Text
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?  @db.Text
  socialFacebook  String?
  socialTwitter   String?
  socialLinkedin  String?
  socialInstagram String?
  socialYoutube   String?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  heroVideoUrl    String?
  smtpHost        String?
  smtpPort        Int?     @default(587)
  smtpUser        String?
  smtpPass        String?
  smtpFromEmail   String?
  smtpFromName    String?
  smtpSecure          Boolean  @default(false)
  whatsappNumber      String?
  whatsappMessage     String?
  searchSuggestions   String[] @default([])
  blogNotifyOnPublish Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model ContactInquiry {
  id         String         @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  subject    String?
  message    String         @db.Text
  type       String         @default("general")
  status     InquiryStatus  @default(PENDING)
  adminReply String?        @db.Text
  repliedAt  DateTime?
  createdAt  DateTime       @default(now())
}

model ResumeApplication {
  id            String             @id @default(cuid())
  name          String
  email         String
  phone         String?
  positionCategory String?
  position      String?
  photoUrl      String?
  dateOfBirth   String?
  address       String?            @db.Text
  summary       String?            @db.Text
  education     Json               @default("[]")
  experience    Json               @default("[]")
  skills        String?            @db.Text
  languages     String?
  hasExperience Boolean            @default(false)
  status        ResumeStatus       @default(PENDING)
  adminNotes    String?            @db.Text
  sortOrder     Int                @default(0)
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attachments   ResumeAttachment[]
  jobId         String?
  job           JobPosting?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
}

model ResumeAttachment {
  id            String               @id @default(cuid())
  applicationId String
  application   ResumeApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ResumeAttachmentType
  fileName      String
  fileUrl       String
  createdAt     DateTime             @default(now())
}

model JobPosting {
  id             String             @id @default(cuid())
  title          String
  slug           String             @unique
  department     String
  location       String?
  employmentType EmploymentType     @default(FULL_TIME)
  summary        String?
  description    String             @db.Text
  requirements   String?            @db.Text
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  applications   ResumeApplication[]

  @@index([isActive, sortOrder])
  @@index([department])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  guestEmail  String?
  guestName   String?
  guestPhone  String?
  guestCompany String?
  status      OrderStatus @default(PENDING)
  notes           String?     @db.Text
  subtotalAmount  Decimal?    @db.Decimal(12, 2)
  discountAmount  Decimal?    @db.Decimal(12, 2)
  couponCode         String?
  taxAmount          Decimal?    @db.Decimal(12, 2)
  shippingAmount     Decimal?    @db.Decimal(12, 2)
  promotionDiscount  Decimal?    @db.Decimal(12, 2)
  totalAmount        Decimal?    @db.Decimal(12, 2)
  paymentStatus      PaymentStatus @default(NOT_REQUIRED)
  ccavenueTrackingId String?
  paidAt             DateTime?
  carrier         String?
  trackingNumber  String?
  shippedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          OrderItem[]
  returnRequests ReturnRequest[]
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?
  quantity     Int             @default(1)
  price        Decimal?        @db.Decimal(12, 2)
  gstRate      Decimal?        @db.Decimal(5, 2)
  taxAmount    Decimal?        @db.Decimal(12, 2)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  price      Decimal?    @db.Decimal(12, 2)
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@index([productId, isActive])
}

model ProductBundleItem {
  id                 String  @id @default(cuid())
  bundleProductId    String
  bundleProduct      Product @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product @relation("BundleComponent", fields: [componentProductId], references: [id], onDelete: Cascade)
  quantity           Int     @default(1)
  optionGroup        String?
  sortOrder          Int     @default(0)

  @@index([bundleProductId])
}

model Promotion {
  id              String        @id @default(cuid())
  title           String
  type            PromotionType @default(BOGO)
  buyProductId    String
  buyProduct      Product       @relation("PromotionBuy", fields: [buyProductId], references: [id], onDelete: Cascade)
  getProductId    String
  getProduct      Product       @relation("PromotionGet", fields: [getProductId], references: [id], onDelete: Cascade)
  buyQuantity     Int           @default(1)
  getQuantity     Int           @default(1)
  startsAt        DateTime
  endsAt          DateTime?
  isActive        Boolean       @default(true)
  excludeCoupons  Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([isActive, startsAt, endsAt])
}

/// Standalone archive — no FK to Order, User, or Product (record-only)
model DeletedOrder {
  id             String      @id @default(cuid())
  orderNumber    String
  status         OrderStatus
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  guestCompany   String?
  customerName   String?
  customerEmail  String?
  notes          String?     @db.Text
  subtotalAmount Decimal?    @db.Decimal(12, 2)
  discountAmount Decimal?    @db.Decimal(12, 2)
  couponCode     String?
  totalAmount    Decimal?    @db.Decimal(12, 2)
  items          Json
  orderCreatedAt DateTime
  deletedAt      DateTime    @default(now())
  deletedBy      String?

  @@index([orderNumber])
  @@index([deletedAt])
}

model QuoteRequest {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  name        String
  email       String
  phone       String?
  company     String?
  message     String?     @db.Text
  status      OrderStatus @default(QUOTE_REQUESTED)
  totalAmount Decimal?    @db.Decimal(12, 2)
  quotedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       QuoteItem[]
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int          @default(1)
  unitPrice      Decimal?     @db.Decimal(12, 2)
  notes          String?
}

model PageVisit {
  id         String   @id @default(cuid())
  path       String
  referrer   String?
  visitorKey String
  userAgent  String?
  device     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorKey])
  @@index([createdAt, visitorKey])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@index([subscribedAt])
}

model DownloadResource {
  id            String   @id @default(cuid())
  title         String
  description   String?
  fileUrl       String
  fileName      String
  fileType      String   @default("PDF")
  fileSizeBytes Int?
  requiresLogin Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  caption   String?
  imageUrl  String
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}

model CompanyHistory {
  id          String   @id @default(cuid())
  year        Int
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder, year])
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  department String?
  bio        String?  @db.Text
  photoUrl   String
  photoFocalX Float   @default(50)
  photoFocalY Float   @default(38)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ProductLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  freeShipping   Boolean              @default(false)
  productIds     String[]             @default([])
  allowedUserIds String[]             @default([])
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  emailCampaigns CouponEmailCampaign[]
}

model CouponEmailCampaign {
  id          String                    @id @default(cuid())
  couponId    String
  coupon      Coupon                    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  segment     CouponEmailSegment        @default(ALL_USERS)
  userIds     String[]                  @default([])
  subject     String
  message     String?                   @db.Text
  scheduledAt DateTime?
  sentAt      DateTime?
  status      CouponEmailCampaignStatus @default(SCHEDULED)
  sentCount   Int                       @default(0)
  failedCount Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([status, scheduledAt])
}

model ReturnRequest {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       ReturnRequestType
  reason     String              @db.Text
  itemNotes  String?             @db.Text
  status     ReturnRequestStatus @default(PENDING)
  adminNotes String?             @db.Text
  resolvedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status])
  @@index([userId])
}

model LedgerRequest {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodFrom  DateTime
  periodTo    DateTime
  gstin       String?
  notes       String?             @db.Text
  status      LedgerRequestStatus @default(PENDING)
  adminNotes  String?             @db.Text
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([userId])
}

model ErpCustomerImport {
  id           String              @id @default(cuid())
  fileName     String?
  rowCount     Int                 @default(0)
  createdCount Int                 @default(0)
  updatedCount Int                 @default(0)
  skippedCount Int                 @default(0)
  importedAt   DateTime            @default(now())
  records      ErpCustomerRecord[]
}

model ErpCustomerRecord {
  id                String             @id @default(cuid())
  erpCustomerNumber String             @unique
  phoneNormalized   String
  phoneRaw          String?
  customerName      String?
  company           String?
  email             String?
  gstNo             String?
  panNo             String?
  state             String?
  address           String?
  others            String?
  erpStatus         String?
  importId          String?
  import            ErpCustomerImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([erpCustomerNumber])
  @@index([phoneNormalized])
}
